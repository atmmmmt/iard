# ---------------------------------------------------------------------------
# server/.env  —  الإنتاج (iard.prootech-agency.com)
# انسخه إلى /srv/iard-academy/api/server/.env وعبّئ الأسرار.
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=5000

MONGODB_URI=mongodb://127.0.0.1:27017/iard_academy

# ولّده على السيرفر:  openssl rand -hex 48
JWT_SECRET=REPLACE_ME
JWT_EXPIRES_IN=8h
COOKIE_NAME=iard_admin

# أصول الواجهة المسموح لها (CORS مع credentials).
CLIENT_ORIGIN=https://academy-iard.com,https://www.academy-iard.com

UPLOAD_DIR=/srv/iard-academy/uploads
MAX_UPLOAD_MB=15

# حساب الأدمن الأول — يُستخدم مرة واحدة مع `npm run seed` ثم غيّر كلمة السر.
ADMIN_NAME=IARD Administrator
ADMIN_EMAIL=admin@academy-iard.com
ADMIN_PASSWORD=REPLACE_ME_STRONG_PASSWORD
