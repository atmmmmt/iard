# ---------------------------------------------------------------------------
# I.A.R.D Academy Portal — Backend API (Express + MongoDB)
# Copy to server/.env and fill in. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=production
PORT=5000

# Database (use a managed MongoDB in production, e.g. Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/iard_academy

# Security — REQUIRED in production.
# Generate a long random secret, e.g.:  openssl rand -hex 48
JWT_SECRET=change-me-to-a-long-random-64+char-secret
JWT_EXPIRES_IN=8h
COOKIE_NAME=iard_admin

# Comma-separated list of allowed frontend origins (CORS).
# Production: https://your-domain.com
CLIENT_ORIGIN=http://localhost:3000

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=15

# ---------------------------------------------------------------------------
# Seed admin account (used only by `npm run seed`). Delete/rotate after first run.
# ADMIN_PASSWORD must be at least 12 characters.
# ---------------------------------------------------------------------------
ADMIN_NAME=IARD Administrator
ADMIN_EMAIL=admin@iard-academy.org
ADMIN_PASSWORD=change-this-strong-password
