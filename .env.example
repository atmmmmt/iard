# ---------------------------------------------------------------------------
# I.A.R.D Academy Portal — Frontend (vinext / Cloudflare Workers runtime)
# Copy to .env.local for local dev, or .env for production, then fill in.
# ---------------------------------------------------------------------------

# Base URL of the backend API (Express server). Include the /api suffix.
# Local dev:   http://localhost:5000/api
# Production:  https://your-domain.com/api   (served behind Nginx, same domain)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Demo mode. MUST be "false" in production so the site uses the real database
# and the admin login/guard are enforced. Leave "true" only for design demos.
NEXT_PUBLIC_DEMO_MODE=false

# Public canonical site URL — used by sitemap.xml / robots.txt / SEO metadata.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
